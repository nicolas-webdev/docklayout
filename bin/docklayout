#!/usr/bin/env python3
"""Save and load macOS Dock layouts.

Snapshots only persistent-apps and persistent-others, so size, autohide,
magnification, and hot corners stay untouched. Bookmark data inside each
tile is kept; it is not run through JSON.
"""

from __future__ import annotations

import json
import os
import plistlib
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path

VERSION = "0.1.0"
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
LAYOUT_KEYS = ("persistent-apps", "persistent-others")
GENERATED_MARK = "@generated by docklayout"
BACKUP_KEEP = 10

USAGE = f"""docklayout {VERSION}

Usage:
  docklayout                 Pick a layout and switch to it
  docklayout save <name>     Snapshot the current Dock
  docklayout load <name>     Switch to a saved layout
  docklayout list            List saved layouts
  docklayout show [name]     Print a layout, or the live Dock
  docklayout delete <name>   Delete a saved layout
  docklayout undo            Restore the Dock from before the last switch
  docklayout refresh         Regenerate Raycast commands

Layouts: ~/.config/docklayout/layouts
Raycast: ~/raycast-scripts
"""


def base_dir() -> Path:
    override = os.environ.get("DOCKLAYOUT_DIR")
    if override:
        return Path(override).expanduser()
    return Path.home() / ".config" / "docklayout"


def layout_dir() -> Path:
    return base_dir() / "layouts"


def backup_dir() -> Path:
    return base_dir() / "backups"


def raycast_dir() -> Path:
    override = os.environ.get("DOCKLAYOUT_RAYCAST_DIR")
    if override:
        return Path(override).expanduser()
    return Path.home() / "raycast-scripts"


def die(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def validate_name(name: str) -> str:
    if not NAME_RE.fullmatch(name):
        die(
            "Invalid layout name: "
            f"{name}\n"
            "Use letters, numbers, dots, underscores, or hyphens "
            "(max 64 characters, must start with a letter or number)."
        )
    return name


def ensure_dirs() -> None:
    for path in (layout_dir(), backup_dir(), raycast_dir()):
        path.mkdir(parents=True, exist_ok=True)


def cli_path() -> str:
    raw = Path(sys.argv[0])
    if raw.is_absolute():
        # Keep a symlink path. Resolving it would pin Homebrew installs
        # to a Cellar version that disappears on upgrade.
        return str(raw)
    found = shutil.which(str(raw))
    return found or str(raw.resolve())


def export_dock(path: Path) -> None:
    subprocess.run(
        ["defaults", "export", "com.apple.dock", str(path)],
        check=True,
        stdout=subprocess.DEVNULL,
    )


def read_plist(path: Path) -> dict:
    with path.open("rb") as handle:
        data = plistlib.load(handle)
    if not isinstance(data, dict):
        die(f"Unexpected plist: {path}")
    return data


def write_plist(data: dict, path: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    with temporary.open("wb") as handle:
        plistlib.dump(data, handle, fmt=plistlib.FMT_BINARY)
    os.replace(temporary, path)


def live_dock() -> dict:
    with tempfile.TemporaryDirectory(prefix="docklayout-") as tmp:
        path = Path(tmp) / "dock.plist"
        export_dock(path)
        return read_plist(path)


def extract_layout(dock: dict) -> dict:
    layout: dict = {}
    for key in LAYOUT_KEYS:
        value = dock.get(key, [])
        if not isinstance(value, list):
            die(f"Dock preference {key} is not a list")
        layout[key] = value
    return layout


def item_label(item: object) -> str:
    if not isinstance(item, dict):
        return "[item]"
    tile = item.get("tile-data")
    if not isinstance(tile, dict):
        tile = {}
    label = tile.get("file-label") or tile.get("label")
    if isinstance(label, str) and label.strip():
        return label
    kind = item.get("tile-type")
    labels = {
        "spacer-tile": "— spacer —",
        "small-spacer-tile": "— small spacer —",
        "flex-spacer-tile": "— flexible spacer —",
    }
    if isinstance(kind, str):
        return labels.get(kind, f"[{kind}]")
    return "[item]"


def format_layout(layout: dict, heading: str) -> str:
    lines = [heading]
    sections = (
        ("persistent-apps", "Apps"),
        ("persistent-others", "Folders and stacks"),
    )
    for key, title in sections:
        items = layout.get(key) or []
        lines.append(f"{title} ({len(items)})")
        if not items:
            lines.append("  (empty)")
            continue
        for index, item in enumerate(items, 1):
            lines.append(f"  {index:2}. {item_label(item)}")
    return "\n".join(lines)


def layout_path(name: str) -> Path:
    return layout_dir() / f"{name}.plist"


def saved_names() -> list[str]:
    if not layout_dir().is_dir():
        return []
    return sorted(
        (path.stem for path in layout_dir().glob("*.plist") if path.is_file()),
        key=str.lower,
    )


def assert_unique(name: str) -> None:
    slug = name.lower()
    for existing in saved_names():
        if existing != name and existing.lower() == slug:
            die(f'Layout "{existing}" already uses that name.')


def save_layout(name: str) -> None:
    validate_name(name)
    ensure_dirs()
    assert_unique(name)
    write_plist(extract_layout(live_dock()), layout_path(name))
    refresh_raycast()
    print(f"Saved Dock layout: {name}")


def prune_backups() -> None:
    backups = sorted(backup_dir().glob("*.plist"))
    for old in backups[:-BACKUP_KEEP]:
        old.unlink()


def backup_live() -> Path:
    ensure_dirs()
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    path = backup_dir() / f"{stamp}.plist"
    suffix = 1
    while path.exists():
        path = backup_dir() / f"{stamp}-{suffix}.plist"
        suffix += 1
    write_plist(extract_layout(live_dock()), path)
    prune_backups()
    return path


def apply_layout(layout: dict) -> None:
    with tempfile.TemporaryDirectory(prefix="docklayout-") as tmp:
        current_path = Path(tmp) / "current.plist"
        merged_path = Path(tmp) / "merged.plist"
        export_dock(current_path)
        current = read_plist(current_path)
        for key in LAYOUT_KEYS:
            current[key] = layout.get(key, [])
        write_plist(current, merged_path)
        subprocess.run(
            ["defaults", "import", "com.apple.dock", str(merged_path)],
            check=True,
            stdout=subprocess.DEVNULL,
        )
    subprocess.run(
        ["killall", "Dock"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def load_layout(name: str) -> None:
    validate_name(name)
    path = layout_path(name)
    if not path.is_file():
        die(
            f'No saved layout "{name}". '
            f"Arrange the Dock, then run: docklayout save {name}"
        )
    backup_live()
    apply_layout(read_plist(path))
    print(f"Loaded Dock layout: {name}")


def list_layouts() -> None:
    names = saved_names()
    if not names:
        print("No Dock layouts saved.")
        return
    print("\n".join(names))


def show_layout(name: str | None) -> None:
    if name is None:
        print(format_layout(extract_layout(live_dock()), "Live Dock"))
        return
    validate_name(name)
    path = layout_path(name)
    if not path.is_file():
        die(f'No saved layout "{name}".')
    print(format_layout(read_plist(path), name))


def delete_layout(name: str) -> None:
    validate_name(name)
    path = layout_path(name)
    if not path.is_file():
        die(f'No saved layout "{name}".')
    path.unlink()
    refresh_raycast()
    print(f"Deleted Dock layout: {name}")


def undo() -> None:
    backups = sorted(path for path in backup_dir().glob("*.plist") if path.is_file())
    if not backups:
        die("Nothing to undo yet. A backup is taken each time a layout is loaded.")
    previous = backups[-1]
    backup_live()
    apply_layout(read_plist(previous))
    print(f"Restored Dock from {previous.stem}")


def script_body(name: str, cli: str) -> str:
    quoted_cli = shlex.quote(cli)
    quoted_name = shlex.quote(name)
    return f"""#!/bin/zsh
# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title Dock: {name}
# @raycast.mode silent

# Optional parameters:
# @raycast.icon 🖥️
# @raycast.packageName Dock Layouts
# @raycast.description Switch the Dock to the {name} layout

# {GENERATED_MARK}
exec {quoted_cli} load {quoted_name}
"""


def dropdown_script(names: list[str], cli: str) -> str:
    quoted_cli = shlex.quote(cli)
    data = [{"title": name, "value": name} for name in names]
    argument = json.dumps(
        {"type": "dropdown", "placeholder": "Layout", "data": data},
        ensure_ascii=False,
        separators=(", ", ": "),
    )
    return f"""#!/bin/zsh
# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title Set Dock Layout
# @raycast.mode compact

# Optional parameters:
# @raycast.icon 🖥️
# @raycast.packageName Dock Layouts
# @raycast.description Switch between saved macOS Dock layouts
# @raycast.argument1 {argument}

# {GENERATED_MARK}
exec {quoted_cli} load "$1"
"""


def empty_script() -> str:
    return f"""#!/bin/zsh
# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title Set Dock Layout
# @raycast.mode compact

# Optional parameters:
# @raycast.icon 🖥️
# @raycast.packageName Dock Layouts
# @raycast.description Save a Dock layout, then run this again

# {GENERATED_MARK}
echo "No Dock layouts yet. Arrange the Dock, then run: docklayout save Work"
exit 1
"""


def refresh_raycast() -> None:
    ensure_dirs()
    directory = raycast_dir()
    names = saved_names()
    cli = cli_path()
    expected = {"set-dock-layout.sh"}

    if names:
        write_executable(directory / "set-dock-layout.sh", dropdown_script(names, cli))
        for name in names:
            filename = f"dock-{name.lower()}.sh"
            expected.add(filename)
            write_executable(directory / filename, script_body(name, cli))
    else:
        write_executable(directory / "set-dock-layout.sh", empty_script())

    for path in directory.glob("*.sh"):
        if path.name in expected:
            continue
        text = path.read_text(errors="replace")
        if GENERATED_MARK in text:
            path.unlink()


def write_executable(path: Path, content: str) -> None:
    path.write_text(content)
    path.chmod(0o755)


def interactive() -> None:
    names = saved_names()
    if not names:
        die("No Dock layouts saved. Arrange the Dock, then run: docklayout save Work")
    print("Dock layouts")
    for index, name in enumerate(names, 1):
        print(f"  {index}. {name}")
    try:
        choice = input("Load (number or name, q to quit): ").strip()
    except EOFError:
        print()
        return
    if choice.lower() in {"", "q", "quit"}:
        return
    if choice.isdigit():
        index = int(choice)
        if 1 <= index <= len(names):
            load_layout(names[index - 1])
            return
        die(f"No layout numbered {choice}.")
    matches = [name for name in names if name.lower() == choice.lower()]
    if len(matches) == 1:
        load_layout(matches[0])
        return
    die(f'No saved layout "{choice}".')


def main(argv: list[str]) -> None:
    if sys.platform != "darwin":
        die("docklayout only works on macOS.")
    if len(argv) > 1 and argv[1] in {"--version", "-V"}:
        print(VERSION)
        return
    if len(argv) < 2 or argv[1] in {"help", "-h", "--help"}:
        if len(argv) < 2 and sys.stdin.isatty() and sys.stdout.isatty():
            interactive()
            return
        stream = sys.stdout if len(argv) > 1 else sys.stderr
        print(USAGE, end="" if USAGE.endswith("\n") else "\n", file=stream)
        raise SystemExit(0 if len(argv) > 1 else 1)

    command = argv[1]
    if command == "save" and len(argv) == 3:
        save_layout(argv[2])
    elif command == "load" and len(argv) == 3:
        load_layout(argv[2])
    elif command == "list" and len(argv) == 2:
        list_layouts()
    elif command in ("show", "current") and len(argv) == 2:
        show_layout(None)
    elif command == "show" and len(argv) == 3:
        show_layout(argv[2])
    elif command == "delete" and len(argv) == 3:
        delete_layout(argv[2])
    elif command == "undo" and len(argv) == 2:
        undo()
    elif command == "refresh" and len(argv) == 2:
        refresh_raycast()
        print(raycast_dir())
    else:
        print(USAGE, file=sys.stderr)
        raise SystemExit(1)


if __name__ == "__main__":
    main(sys.argv)
